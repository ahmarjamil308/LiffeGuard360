# ==============================================================================
# LifeGuard 360 Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_APP=run.py
DEBUG=True
PORT=5000
HOST=0.0.0.0

# Security Keys (Replace with cryptographically random 64-character hex strings in production)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_flask_secret_key_in_production
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Persistent MySQL Database Connection
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# For local development with MySQL:
DATABASE_URL=mysql+pymysql://lifeguard_user:your_secure_password@localhost:3306/lifeguard360
# For isolated tests without external MySQL instance, set:
# DATABASE_URL=sqlite:///lifeguard360_test.db

# Safety & Monitoring Defaults
DEFAULT_CHECKIN_GRACE_PERIOD_MINUTES=10
DEFAULT_PRE_ALERT_COUNTDOWN_SECONDS=20
MAX_CHECKIN_GRACE_PERIOD_MINUTES=60
MIN_CHECKIN_GRACE_PERIOD_MINUTES=1

# External Integration Providers (Optional / Fallback modes)
# Firebase Cloud Firestore & Realtime Database Storage
FIREBASE_ENABLED=False
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=lifeguard360-project
FIREBASE_DATABASE_URL=https://lifeguard360-project-default-rtdb.firebaseio.com
FIREBASE_SYNC_MODE=AUTO

# SMS Gateway (TWILIO or MOCK)
SMS_PROVIDER=MOCK
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Country Emergency Default Configuration (ISO-3166-1 alpha-2 / local helpline)
DEFAULT_COUNTRY_CODE=US
DEFAULT_EMERGENCY_NUMBER=911
